{
  "name": "dsc-plugin-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "dsc 插件开发模板:TypeScript + esbuild,打包为单个浏览器 ESM 产物",
  "license": "Apache-2.0",
  "author": "omds-chat",
  "scripts": {
    "build": "node build.mjs",
    "type": "tsc --noEmit",
    "validate:specs": "node scripts/validate-specs.mjs"
  },
  "dsc": {
    "engines": "^1.0.0",
    "description": {
      "zh-CN": "dsc 插件开发模板",
      "en-US": "dsc plugin development template"
    },
    "home_page": "https://github.com/omds-chat/dsc-plugin-template",
    "repo_link": "https://github.com/omds-chat/dsc-plugin-template",
    "capabilities": ["events:session", "notify"],
    "mounts": ["session:changed"]
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
