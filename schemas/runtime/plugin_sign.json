{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omdsc-dev.github.io/dsc-plugin-template/schemas/runtime/plugin_sign.json",
  "type": "object",
  "title": "签名清单",
  "description": "多个文件的签名信息集合",
  "properties": {
    "sign": {
      "type": "array",
      "description": "签名条目数组",
      "items": {
        "type": "object",
        "title": "签名项",
        "description": "单个文件的一条签名",
        "properties": {
          "value": {
            "type": "string",
            "description": "签名值"
          },
          "for": {
            "type": "string",
            "description": "被签名的文件名称"
          },
          "signer": {
            "type": "string",
            "description": "签名者标识"
          }
        },
        "required": [
          "value",
          "for",
          "signer"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sign"
  ],
  "additionalProperties": false
}
