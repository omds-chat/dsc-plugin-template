{
  "name": "@alice/dsc-demo-log",
  "version": "1.2.0",
  "license": "Apache-2.0",
  "description": {
    "zh-CN": "带能力、挂载点与冲突声明的示例插件",
    "en-US": "Demo plugin with capabilities, mounts and conflicts"
  },
  "author": "Alice",
  "home_page": "https://github.com/example/dsc-demo-log",
  "repo_link": "https://github.com/example/dsc-demo-log",
  "capabilities": [
    "sessions:read",
    "events:session",
    "chat:request",
    "plugins:storage"
  ],
  "mounts": [
    "session:changed",
    "chat:before-request"
  ],
  "conflicts": [
    "dsc-demo-log-legacy"
  ],
  "dependencies": {
    "dsc": "^1.0.0"
  },
  "attached": {
    "favicon": "https://example.com/favicon.ico",
    "intro_image": [
      "https://example.com/intro.png"
    ]
  }
}
